# Required in production. Use a unique value with at least 32 characters.
STUDIO_SESSION_SECRET=replace-with-a-long-random-secret
STUDIO_USERNAME=marketing
STUDIO_PASSWORD=replace-with-a-strong-password
STUDIO_TRUST_PROXY_HEADERS=true

# Mount a persistent Railway volume at /data.
STUDIO_DATA_PATH=/data/studio.json
STUDIO_UPLOAD_PATH=/data/uploads

# Canonical deployment origin or full Studio URL; both forms are accepted.
PUBLIC_STUDIO_URL=https://studio.example.com
